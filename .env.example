PROJECT_NAME="Facial Attendance System"
DATABASE_URL="sqlite:///./data/attendance.db"
# Cooldown/buffer in seconds after marking attendance before allowing the same student or gate reset
RECOGNITION_COOLDOWN_SECONDS=6
# Cosine similarity threshold for OpenCV SFace face recognition (0.363 is recommended standard, range 0.0 to 1.0)
SIMILARITY_THRESHOLD=0.363
# YuNet face detection confidence threshold (range 0.0 to 1.0)
YUNET_SCORE_THRESHOLD=0.6
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["*"]
